# WellOS LOCAL SYNTHETIC-FIXTURE MODE — development and test only.
#
# Copy to .env.development and run the API with the `dev-fixtures` feature:
#   make server-fixtures            (Linux/macOS)
#   see docs/operations/runbook.md  (Windows PowerShell)
#
# Everything enabled here is refused at startup when WELLOS_ENV is staging
# or production, and the fake providers / seed / development sign-in are
# not even compiled into a build without `--features dev-fixtures`.
# All patients, users and clinical content produced in this mode are
# synthetic: the tenant is marked synthetic and every seeded human identity
# has an OIDC subject of the form `synthetic|<username>`.

WELLOS_ENV=development
WELLOS_CELL=cell-dev-1
DATABASE_URL=postgres://wellos:wellos_dev@localhost:5432/wellos
# Loopback only: development tokens (dev-<username>) are guessable.
WELLOS_BIND_ADDR=127.0.0.1:8080
WELLOS_ALLOWED_ORIGINS=http://localhost:3000
RUST_LOG=info,wellos_server=debug

# Development sign-in (server-controlled). The web app discovers whether it
# exists from GET /api/auth/providers and lists the synthetic users from the
# backend; nothing about authentication is decided in the browser bundle.
WELLOS_DEV_AUTH=true

# Deterministic offline AI fixtures. Output is clearly labelled as
# synthetic in the UI and in every AI artifact (synthetic=true) and never
# contacts the network.
DMIND_MODEL_PROVIDER=fake
WELLOS_SCRIBE_PROVIDER=fake
WELLOS_SCRIBE_LANGUAGES=en,es

# Required for `make seed` / `cargo run --bin seed --features dev-fixtures`.
WELLOS_ALLOW_SYNTHETIC_SEED=true

# --- Real-provider local mode (optional) -----------------------------------
# To exercise the real adapters locally against synthetic patients, replace
# the two providers above and set WELLOS_ALLOW_EXTERNAL_AI=true. In
# development an http://127.0.0.1 endpoint is accepted so a controlled
# local test server can stand in for the provider; anything else must be
# https:// and allowlisted exactly as in .env.example.
# WELLOS_ALLOW_EXTERNAL_AI=true
# DMIND_MODEL_PROVIDER=openai_compatible
# DMIND_MODEL_ENDPOINT=https://api.example.org/v1/chat/completions
# DMIND_MODEL_ALLOWED_HOSTS=api.example.org
# DMIND_MODEL_NAME=
# DMIND_MODEL_API_KEY=
# WELLOS_SCRIBE_PROVIDER=openai_compatible
# WELLOS_SCRIBE_ENDPOINT=https://api.example.org/v1/audio/transcriptions
# WELLOS_SCRIBE_ALLOWED_HOSTS=api.example.org
# WELLOS_SCRIBE_MODEL=
# WELLOS_SCRIBE_API_KEY=
