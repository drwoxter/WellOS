# WellOS environment template — PRODUCTION-SAFE DEFAULTS.
#
# Copy to .env and fill in the values for your deployment. Nothing in this
# file enables development authentication, synthetic fixtures or a fake AI
# provider; those live in .env.development.example and are refused at
# startup whenever WELLOS_ENV is staging or production.
#
# Never commit real credentials or PHI.

# --- Runtime --------------------------------------------------------------
# REQUIRED. Exactly one of: development | test | staging | production.
# Missing or unknown values fail closed at startup (there is no default).
WELLOS_ENV=production
# REQUIRED outside development/test: the regional cell stamped on events
# and provenance.
WELLOS_CELL=cell-eu-1
DATABASE_URL=postgres://wellos:CHANGE_ME@db.internal:5432/wellos
WELLOS_BIND_ADDR=127.0.0.1:8080
# Comma-separated browser origins allowed by CORS. Required in production.
WELLOS_ALLOWED_ORIGINS=https://app.example.org
RUST_LOG=info

# --- Authentication (OIDC / OAuth 2.1) --------------------------------------
# Development tokens are OFF by default and can only be switched on in
# WELLOS_ENV=development|test on a build with the `dev-fixtures` feature.
WELLOS_DEV_AUTH=false
# All of the following are required when dev auth is off; startup fails
# closed otherwise. No provider is bundled: point these at your IdP.
WELLOS_OIDC_ISSUER=https://idp.example.org/
WELLOS_OIDC_AUDIENCE=wellos-api
# Resolve the JWKS via OIDC discovery from the pinned issuer (HTTPS only),
# or provide inline JWKS JSON / a JWKS file exported from the IdP.
WELLOS_OIDC_DISCOVERY=true
# WELLOS_OIDC_JWKS_JSON={"keys":[...]}
# WELLOS_OIDC_JWKS_PATH=/etc/wellos/jwks.json
# WELLOS_OIDC_JWKS_REFRESH_SECS=3600
# WELLOS_OIDC_JWKS_MIN_REFRESH_SECS=30
# WELLOS_OIDC_LEEWAY_SECS=60
# Require an MFA signal from validated OIDC claims (amr / acr). Missing or
# malformed claims fail closed.
WELLOS_OIDC_REQUIRE_MFA=true
WELLOS_OIDC_ACCEPTED_AMR=mfa,otp,hwk
# WELLOS_OIDC_ACCEPTED_ACR=phrh
# Browser login (Authorization Code + PKCE, S256). The redirect URI is
# exact — register the BFF callback route at the IdP. Client secret is
# optional (PKCE is always required).
WELLOS_OIDC_CLIENT_ID=wellos-web
# WELLOS_OIDC_CLIENT_SECRET=
WELLOS_OIDC_REDIRECT_URI=https://app.example.org/api/auth/oidc/callback
# WELLOS_OIDC_LOGIN_TXN_SECS=600

# Opaque browser-session lifetimes (seconds): absolute cap and idle timeout.
# WELLOS_SESSION_ABSOLUTE_SECS=28800
# WELLOS_SESSION_IDLE_SECS=1800
# Per-user break-glass activations allowed per hour (default 5).
# WELLOS_BREAK_GLASS_HOURLY_LIMIT=5

# --- Rate limits (requests per minute, shared across replicas) -------------
# WELLOS_RATE_LOGIN_PER_MIN=10
# WELLOS_RATE_SEARCH_PER_MIN=30
# WELLOS_RATE_CRED_ADMIN_PER_MIN=30
# WELLOS_RATE_API_PER_MIN=600
# WELLOS_RATE_SCRIBE_PER_MIN=6
# WELLOS_RATE_VISIT_CREATE_PER_MIN=30
# Peer IPs (BFF / reverse proxies) trusted to assert the end-client address
# for anonymous login rate limiting; from any other peer those headers are
# ignored.
# WELLOS_TRUSTED_PROXIES=10.0.0.5,10.0.0.6

# --- Web (BFF) --------------------------------------------------------------
# API base URL used by the Next.js server-side proxy.
WELLOS_API_URL=http://localhost:8080
# Set ONLY when a trusted platform proxy fronts the web app.
# WELLOS_WEB_BEHIND_TRUSTED_PROXY=false

# --- dMind model gateway ----------------------------------------------------
# disabled (default) | openai_compatible. "fake" exists only on dev-fixtures
# builds in development/test and is refused everywhere else. With
# "disabled" every dMind action is reported as disabled-by-configuration
# and the rest of the product keeps working; nothing is ever fabricated.
DMIND_MODEL_PROVIDER=disabled
# Routing patient data to an external AI provider must be an explicit
# deployment decision; both external providers below require this.
WELLOS_ALLOW_EXTERNAL_AI=false
# openai_compatible: chat-completions endpoint (full URL). Outside
# development it must be https:// on a DNS host with no embedded
# credentials, and that exact host must appear in the allowlist (`host` or
# `host:port`, no wildcards). Redirects are never followed; responses are
# size-bounded; the key never leaves the server; prompts, responses and
# keys are never logged.
# DMIND_MODEL_ENDPOINT=https://api.example.org/v1/chat/completions
# DMIND_MODEL_ALLOWED_HOSTS=api.example.org
# DMIND_MODEL_NAME=
# DMIND_MODEL_API_KEY=
# DMIND_MODEL_CONNECT_TIMEOUT_SECS=5
# DMIND_MODEL_TIMEOUT_SECS=60
# DMIND_MODEL_MAX_RETRIES=2            # 0..=5, transient failures only
# DMIND_MODEL_MAX_RESPONSE_KIB=512
# DMIND_MODEL_MAX_CONCURRENCY=8        # in-flight provider calls per replica
# DMIND_MODEL_QUEUE_TIMEOUT_SECS=10
# Executions per hour before dMind actions answer 429 (identical requests
# reuse the existing artifact and do not count).
# DMIND_QUOTA_TENANT_PER_HOUR=600
# DMIND_QUOTA_TASK_PER_HOUR=200

# --- AI scribe (speech-to-text) -------------------------------------------
# disabled (default) | openai_compatible. "fake" is dev-fixtures only.
WELLOS_SCRIBE_PROVIDER=disabled
# Same endpoint rules as the model gateway. Raw audio is processed in
# memory and never written to disk or the database in any mode.
# WELLOS_SCRIBE_ENDPOINT=https://api.example.org/v1/audio/transcriptions
# WELLOS_SCRIBE_ALLOWED_HOSTS=api.example.org
# WELLOS_SCRIBE_MODEL=
# WELLOS_SCRIBE_API_KEY=
# WELLOS_SCRIBE_TIMEOUT_SECS=60
# WELLOS_SCRIBE_MAX_RETRIES=2
# Comma-separated BCP-47 language tags offered for consultation recording
# (default en,es). Every tag must be accepted by the configured provider.
# WELLOS_SCRIBE_LANGUAGES=en,es,pt-BR

# --- Synthetic fixtures -----------------------------------------------------
# Refused unconditionally in staging/production; see .env.development.example.
WELLOS_ALLOW_SYNTHETIC_SEED=false
