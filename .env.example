# WellOS development environment template.
# Copy to .env and adjust. Never commit real credentials or PHI.
DATABASE_URL=postgres://wellos:wellos_dev@localhost:5432/wellos
# Loopback by default: dev tokens are guessable, so the API must not be
# exposed to the surrounding network without real authentication.
WELLOS_BIND_ADDR=127.0.0.1:8080

# --- Authentication -------------------------------------------------------
# Deployment environment: development | staging | production.
WELLOS_ENV=development
# Development tokens (dev-<username>) are accepted ONLY when both
# WELLOS_ENV=development and WELLOS_DEV_AUTH=true. Startup fails closed if
# WELLOS_DEV_AUTH=true is combined with any other environment.
WELLOS_DEV_AUTH=true
# Production identity provider (OIDC / OAuth 2.1). All three are required
# when dev auth is disabled; startup fails closed otherwise. No provider is
# bundled: point these at your organization's IdP.
# WELLOS_OIDC_ISSUER=https://idp.example.org/
# WELLOS_OIDC_AUDIENCE=wellos-api
# Either inline JWKS JSON or a path to a JWKS file exported from the IdP.
# WELLOS_OIDC_JWKS_JSON={"keys":[...]}
# WELLOS_OIDC_JWKS_PATH=/etc/wellos/jwks.json
# Allowed clock skew in seconds when validating exp/nbf/iat (default 60).
# WELLOS_OIDC_LEEWAY_SECS=60

# Per-user break-glass activations allowed per hour (default 5).
# WELLOS_BREAK_GLASS_HOURLY_LIMIT=5

# Comma-separated browser origins allowed by CORS (default localhost:3000).
# Production deployments must set this explicitly.
# WELLOS_ALLOWED_ORIGINS=https://app.example.org

# Web (BFF) -> API base URL used by the Next.js server-side proxy.
# WELLOS_API_URL=http://localhost:8080
# Set to "true" to show the development token sign-in form in a non-dev
# Next.js build. Never enable outside local development.
# NEXT_PUBLIC_WELLOS_DEV_AUTH=true

# Model gateway provider: "fake" (deterministic, offline) is the only
# provider enabled by default. No external AI provider is contacted.
DMIND_MODEL_PROVIDER=fake
RUST_LOG=info,wellos_server=debug
