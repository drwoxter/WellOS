# WellOS development environment template.
# Copy to .env and adjust. Never commit real credentials or PHI.
DATABASE_URL=postgres://wellos:wellos_dev@localhost:5432/wellos
# Loopback by default: dev tokens are guessable, so the API must not be
# exposed to the surrounding network without real authentication.
WELLOS_BIND_ADDR=127.0.0.1:8080

# --- Authentication -------------------------------------------------------
# Deployment environment: development | staging | production.
WELLOS_ENV=development
# Development tokens (dev-<username>) are accepted ONLY when both
# WELLOS_ENV=development and WELLOS_DEV_AUTH=true. Startup fails closed if
# WELLOS_DEV_AUTH=true is combined with any other environment.
WELLOS_DEV_AUTH=true
# Production identity provider (OIDC / OAuth 2.1). All three are required
# when dev auth is disabled; startup fails closed otherwise. No provider is
# bundled: point these at your organization's IdP.
# WELLOS_OIDC_ISSUER=https://idp.example.org/
# WELLOS_OIDC_AUDIENCE=wellos-api
# Either inline JWKS JSON or a path to a JWKS file exported from the IdP.
# WELLOS_OIDC_JWKS_JSON={"keys":[...]}
# WELLOS_OIDC_JWKS_PATH=/etc/wellos/jwks.json
# Or resolve the JWKS via OIDC discovery from the pinned issuer. The
# discovery metadata issuer must match WELLOS_OIDC_ISSUER and the jwks_uri
# must be HTTPS (development may use http:// toward loopback hosts only).
# Keys are cached and refreshed
# automatically when an unknown key id appears.
# WELLOS_OIDC_DISCOVERY=true
# JWKS cache lifetime and the minimum interval between refresh attempts.
# WELLOS_OIDC_JWKS_REFRESH_SECS=3600
# WELLOS_OIDC_JWKS_MIN_REFRESH_SECS=30
# Allowed clock skew in seconds when validating exp/nbf/iat (default 60).
# WELLOS_OIDC_LEEWAY_SECS=60
# Require an MFA signal from validated OIDC claims: an amr array containing
# one of the accepted values, or an acr string equal to an accepted value.
# Missing or malformed claims fail closed.
# WELLOS_OIDC_REQUIRE_MFA=true
# WELLOS_OIDC_ACCEPTED_AMR=mfa,otp,hwk
# WELLOS_OIDC_ACCEPTED_ACR=phrh

# Browser login (Authorization Code + PKCE, S256). Requires
# WELLOS_OIDC_DISCOVERY=true: the authorization/token endpoints come from
# validated issuer metadata (issuer-pinned, HTTPS outside development).
# The redirect URI is exact — register the BFF callback route at the IdP.
# The client secret is optional (PKCE is always required).
# WELLOS_OIDC_CLIENT_ID=wellos-web
# WELLOS_OIDC_CLIENT_SECRET=
# WELLOS_OIDC_REDIRECT_URI=https://app.example.org/api/auth/oidc/callback
# Server-side login-transaction lifetime in seconds (1..=600, default 600).
# WELLOS_OIDC_LOGIN_TXN_SECS=600

# Opaque browser-session lifetimes (seconds): absolute cap and idle timeout.
# WELLOS_SESSION_ABSOLUTE_SECS=28800
# WELLOS_SESSION_IDLE_SECS=1800

# Per-user break-glass activations allowed per hour (default 5).
# WELLOS_BREAK_GLASS_HOURLY_LIMIT=5

# Shared PostgreSQL-backed rate limits (requests per minute). Counters are
# atomic and shared across API replicas; requests are denied with HTTP 429 +
# Retry-After when exhausted, and denied outright if the store is down.
# WELLOS_RATE_LOGIN_PER_MIN=10
# WELLOS_RATE_SEARCH_PER_MIN=30
# WELLOS_RATE_CRED_ADMIN_PER_MIN=30
# WELLOS_RATE_API_PER_MIN=600
# Comma-separated peer IPs (BFF / reverse proxies) trusted to assert the
# end-client address for anonymous login rate limiting, via
# x-wellos-client-address or the rightmost x-forwarded-for entry. From any
# other peer those headers are ignored and the socket peer address is used.
# WELLOS_TRUSTED_PROXIES=10.0.0.5,10.0.0.6
# Set on the web app ONLY when a trusted platform proxy fronts it, so the
# BFF may derive the end-client address from that proxy's x-forwarded-for.
# WELLOS_WEB_BEHIND_TRUSTED_PROXY=false

# Comma-separated browser origins allowed by CORS (default localhost:3000).
# Production deployments must set this explicitly.
# WELLOS_ALLOWED_ORIGINS=https://app.example.org

# Web (BFF) -> API base URL used by the Next.js server-side proxy.
# WELLOS_API_URL=http://localhost:8080
# Set to "true" to show the development token sign-in form in a non-dev
# Next.js build. Never enable outside local development.
# NEXT_PUBLIC_WELLOS_DEV_AUTH=true

# Model gateway provider: "fake" (deterministic, offline) is the only
# provider enabled by default. No external AI provider is contacted.
DMIND_MODEL_PROVIDER=fake
RUST_LOG=info,wellos_server=debug
